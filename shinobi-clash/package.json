{
  "name": "shinobi-clash",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "Jeu de collection et de combat shinobi au tour par tour, en pixel art façon GBA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "simulate": "tsx tools/simulate.ts",
    "server": "tsx server/index.ts",
    "e2e": "node tools/e2e.mjs http://localhost:4173/ ."
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "playwright": "^1.56.1",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
